filters:
  and:
    - file.inFolder("{{folder}}/golden-tickets")
    - file.ext == "md"
formulas:
  tickets: '"🎫".repeat(if(priority, number(priority), 1))'
properties:
  note.id:
    displayName: Ticket
  note.title:
    displayName: Title
  note.phase:
    displayName: Phase
  formula.tickets:
    displayName: Priority
views:
  - type: kanban
    name: 🍫 Factory floor
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - 💡 Idea
      - 📏 Triage
      - 🧪 Drafting
      - 🎫 Planned
      - 🍫 Baking
      - 🐿️ Reviewing
      - 🚢 Shipped
      - 🗑️ Wont Do
    order:
      - id
      - title
      - phase
      - formula.tickets
    sort:
      - property: priority
        direction: DESC
      - property: file.name
        direction: ASC
  - type: table
    name: 🙋 Your turn
    filters:
      and:
        - phase == "🙋 Awaiting Human"
    order:
      - id
      - title
      - status
      - size
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 🎫 All golden tickets
    order:
      - id
      - title
      - status
      - phase
      - size
      - formula.tickets
      - jira
      - spec_review
      - blocked_by
    sort:
      - property: file.name
        direction: ASC
