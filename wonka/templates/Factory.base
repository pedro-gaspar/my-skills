filters:
  and:
    - file.inFolder("{{folder}}/golden-tickets")
    - file.ext == "md"
properties:
  note.id:
    displayName: Ticket
  note.title:
    displayName: Title
  note.phase:
    displayName: Phase
views:
  - type: kanban
    name: 🍫 Factory floor
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - ✉️-Inbox
      - 🧪-Drafting
      - 🎫-Ready
      - 🍫-Baking
      - 🐿️-Reviewing
      - 🛗-Shipped
      - 🫐-Wont-Do
    order:
      - id
      - title
      - phase
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 🙋 Your turn
    filters:
      and:
        - phase == "🙋-Awaiting-Human"
    order:
      - id
      - title
      - status
      - size
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 🎫 All golden tickets
    order:
      - id
      - title
      - status
      - phase
      - size
      - jira
    sort:
      - property: file.name
        direction: ASC
